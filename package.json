{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.18.0",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "test": "jest --passWithNoTests",
        "test:dependencies": "node --test tests/dependencies/*.test.cjs",
        "test:browser": "pnpm run build && playwright test",
        "type-check": "tsc --noEmit && tsc -p tests/browser/tsconfig.json && tsc -p tests/staging/tsconfig.json",
        "lint": "oxlint --type-aware",
        "lint:fix": "oxlint --type-aware --fix",
        "postinstall": "node scripts/spotlight-noindex.mjs"
    },
    "devDependencies": {
        "@jest/types": "^30.5.1",
        "@playwright/test": "1.64.0",
        "@swc/core": "^1.16.22",
        "@swc/jest": "^0.2.39",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.5",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/jest": "^30.0.0",
        "@types/lodash": "^4.17.27",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "autoprefixer": "^10.6.2",
        "axios": "^1.21.1",
        "baseline-browser-mapping": "^2.11.35",
        "concurrently": "^10.0.7",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "laravel-vite-plugin": "^3.2.1",
        "oxlint": "^1.93.0",
        "oxlint-tsgolint": "^7.0.2006",
        "path": "^0.12.7",
        "postcss": "^8.5.32",
        "tailwindcss": "^4.3.5",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "^7.0.2",
        "vite": "^8.3.8"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@hookform/resolvers": "^5.9.2",
        "@noble/hashes": "^2.4.0",
        "blockhash-core": "^0.1.0",
        "bwh-auth": "0.6.4",
        "class-variance-authority": "^0.7.1",
        "classnames": "^2.5.1",
        "clsx": "^2.1.1",
        "currency.js": "^2.0.4",
        "exifr": "7.1.3",
        "heic-to": "1.6.6",
        "hls.js": "^1.7.4",
        "lodash": "^4.18.1",
        "lucide-react": "^1.72.0",
        "prop-types": "^15.8.1",
        "react": "^19.3.1",
        "react-day-picker": "^10.0.2",
        "react-dom": "^19.3.1",
        "react-hook-form": "^7.92.0",
        "react-markdown": "^10.1.0",
        "recharts": "^3.10.1",
        "remark-gfm": "^4.0.1",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0"
    }
}
