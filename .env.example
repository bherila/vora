APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
DB_DATABASE=database/database.sqlite
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Source bucket for uploaded videos (read by the s3-hls transcoder).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Separate bucket for uploaded photos. Leave these commented unless overriding:
# credentials/endpoint/region fall back to AWS_* when unset, and a blank value
# would defeat that fallback (dotenv treats "KEY=" as set). Set PHOTOS_BUCKET to
# enable a distinct photo bucket; override the others only for a separate account.
# PHOTOS_BUCKET=
# PHOTOS_ACCESS_KEY_ID=
# PHOTOS_SECRET_ACCESS_KEY=
# PHOTOS_REGION=
# PHOTOS_ENDPOINT=
# PHOTOS_USE_PATH_STYLE_ENDPOINT=

# HLS output bucket written by the transcoder (read-only for the app). Same
# fallback rules as PHOTOS_* — set HLS_BUCKET to enable; override others only
# for a separate account.
# HLS_BUCKET=
# HLS_ACCESS_KEY_ID=
# HLS_SECRET_ACCESS_KEY=
# HLS_REGION=
# HLS_ENDPOINT=
# HLS_USE_PATH_STYLE_ENDPOINT=

# Media tuning (optional overrides; see config/media.php).
# MEDIA_KEY_PREFIX=uploads
# MEDIA_PHOTO_MAX_BYTES=26214400
# MEDIA_VIDEO_MAX_BYTES=5368709120
# MEDIA_UPLOAD_URL_TTL=30
# MEDIA_VIEW_URL_TTL=60
# MEDIA_PAGE_SIZE=24
# MEDIA_MULTIPART_THRESHOLD=104857600
# MEDIA_MULTIPART_PART_SIZE=16777216

# Auth (bherila/auth-laravel). Defaults live in config/bherila-auth.php; override here.
# WebAuthn/passkeys require the browser origin(s) to be allow-listed:
WEBAUTHN_RP_NAME="${APP_NAME}"
WEBAUTHN_ALLOWED_ORIGINS=
# Email 2FA + verification emails require a working MAIL_* mailer (above).
# BHERILA_AUTH_AUDIT_DRIVER=database
# BHERILA_AUTH_THROTTLE_ENABLED=true

VITE_APP_NAME="${APP_NAME}"
